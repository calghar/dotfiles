{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "Apple",
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "size": {
            "binaryPrefix": "si",
            "ndigits": 2
        },
        "color": {
            "separator": "blue"
        },
        "separator": " "
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "blue",
                "at": "green",
                "host": "yellow"
            }
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "OS",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "blue"
        },
        {
            "type": "display",
            "key": "Display",
            "keyColor": "blue"
        },
        {
            "type": "de",
            "key": "DE",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "WM Theme",
            "keyColor": "blue"
        },
        {
            "type": "font",
            "key": "Font",
            "keyColor": "blue"
        },
        {
            "type": "cursor",
            "key": "Cursor",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "blue"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "blue"
        },
        {
            "type": "swap",
            "key": "Swap",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": "Disk (/)",
            "keyColor": "blue"
        },
        {
            "type": "localip",
            "key": "Local IP",
            "keyColor": "blue"
        },
        {
            "type": "battery",
            "key": "Battery",
            "keyColor": "blue"
        },
        {
            "type": "poweradapter",
            "key": "Power Adapter",
            "keyColor": "blue"
        },
        {
            "type": "locale",
            "key": "Locale",
            "keyColor": "blue"
        },
        {
            "type": "break"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}